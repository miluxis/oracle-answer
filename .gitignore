# ---- 密钥与环境变量：绝不入库 ----
.env
.env.*
!.env.example

# ---- 数据库：本地开发数据，不入版本库 ----
data/*.db
data/*.db-shm
data/*.db-wal
data/*.sqlite3

# ---- Python ----
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- 管理员上传的图片：运行时产生，不入库 ----
# 如需保留某个重要文件，用 git add -f 单独添加
web/assets/uploads/*
!web/assets/uploads/.gitkeep

# ---- 系统与编辑器 ----
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/
.先读我-版本与打开说明.txt
.版本核验.json

# ---- 日志与临时文件 ----
*.log
*.tmp
/启动本地网站.command

# ---- 但保留项目要求的 assets（图片/模型/文案是网站内容，必须入库）----
!web/assets/

# ---- WorkBuddy 本地工作数据（含会话记忆，不应入库）----
.workbuddy/
