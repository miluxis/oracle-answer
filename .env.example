# 复制本文件为 .env 后再填入真实值。
# ⚠️ .env 已被 .gitignore 忽略，绝不要提交真实密钥。

# ---- 数据库 ----
# 留空 = 使用本地 SQLite（data/oracle.db），开发时无需任何配置
# 线上填写 PostgreSQL 连接串：
# DATABASE_URL=postgresql+psycopg://用户名:密码@127.0.0.1:5432/oracle_answer
DATABASE_URL=

# 会话密钥，生成方式：openssl rand -hex 32
SESSION_SECRET=

# ---- Cookie ----
SESSION_COOKIE=oa_session
# 线上走 HTTPS 必须为 true，否则登录会失败
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# 会话有效期（秒），默认 30 天
SESSION_TTL=2592000

# ---- 注册 ----
# 设为 false 可关闭注册入口
REGISTRATION_OPEN=true

# ---- 管理员 ----
# 逗号分隔，可多个；这些邮箱注册后自动获得 admin 角色
ADMIN_EMAILS=oracleanswered@gmail.com

# ---- Google OAuth（可选，不配则登录页「使用 Google 继续」置灰）----
# 在 https://console.cloud.google.com/ 申请 Web 应用类型凭据
# 授权重定向 URI 需与此处完全一致（含末尾斜杠）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# ---- 站点地址（用于生成分享链接、OAuth 回调等）----
# 线上填写，例：https://ziyou.uu.cn
BASE_URL=http://127.0.0.1:8150

# ---- 服务端口 ----
PORT=8150
